{
  "manifest_version": 3,
  "name": "Article to Podcast",
  "version": "0.0.1",
  "description": "Convert any web article to natural-sounding audio with one click. Listen in-browser or download as MP3.",
  "permissions": [
    "activeTab",
    "storage",
    "downloads",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "https://api.openai.com/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["lib/Readability.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["player/player.html", "player/player.css"],
      "matches": ["<all_urls>"]
    }
  ]
}
